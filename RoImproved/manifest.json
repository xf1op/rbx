{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "RoImproved",
  "short_name": "RoImproved",
  "version": "1.2",
  "description": "A lightweight extension that loads selected Roblox improvements only.",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://avatar.roblox.com/*",
    "https://thumbnails.roblox.com/*",
    "https://apis.roblox.com/*",
    "https://users.roblox.com/*",
    "https://inventory.roblox.com/*",
    "https://voice.roblox.com/*",
    "https://games.roblox.com/*",
    "https://badges.roblox.com/*",
    "https://friends.roblox.com/*",
    "https://groups.roblox.com/*",
    "https://catalog.roblox.com/*",
    "https://economy.roblox.com/*",
    "https://rbxcdn.com/*",
    "https://*.rbxcdn.com/*",
    "https://robloxusercontent.com/*",
    "https://*.robloxusercontent.com/*",
    "https://thumbnailsresizer.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RoImproved",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "deleted-user-profile.html",
        "deleted-user-profile.js",
        "deleted-user-profile-renderer.js",
        "deleted-user-profile-renderer.css"
      ],
      "matches": [
        "https://www.roblox.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://rbxcdn.com https://*.rbxcdn.com https://robloxusercontent.com https://*.robloxusercontent.com https://*.roblox.com https://thumbnailsresizer.roblox.com;"
  }
}
